# Database (Postgres — Neon/Supabase, or point this at a Cloudflare D1 shim)
DATABASE_URL="postgresql://user:password@host:5432/nec"

# Auth.js
AUTH_SECRET="generate-with: npx auth secret"

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="NEC Nepal <no-reply@necnepal.com>"

# Two dedicated inboxes for attendance alerts and careers/intern notifications
HIRING_ALERT_EMAIL_1=""
HIRING_ALERT_EMAIL_2=""

# AI chatbot — fallback chain, same pattern as ERG's report reviewer.
# Only the first key you fill in is required; others are optional fallbacks.
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# Shared secret so only Vercel Cron (or you, manually) can hit the cron routes
CRON_SECRET="generate-a-random-string"

# File storage for CVs/photos — Cloudflare R2 credentials, or swap for Vercel Blob
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
